# coturn 노드 설정 예시 — 복사해서 .env 로 사용(docker-compose.coturn.yml 참조).
#
# ★ 멀티노드 핵심: TURN_SECRET 은 모든 노드 + 백엔드에서 동일해야 한다(use-auth-secret HMAC 검증).
#   각 노드는 자신의 공인 IP(TURN_EXTERNAL_IP)와 고유 이름(TURN_NODE_NAME)만 다르게 둔다.

# 공유 시크릿(모든 노드 + 백엔드 .env 의 TURN_SECRET 과 동일) — 32바이트+ 랜덤 권장:
#   openssl rand -hex 32
TURN_SECRET=replace-with-shared-secret

# realm(보통 서비스 도메인, 전 노드 공통)
TURN_REALM=metanova1004.com

# 이 노드의 공인 IP(노드마다 다름) — relay 후보가 공인 IP여야 LTE/5G에서 도달 가능
TURN_EXTERNAL_IP=203.0.113.10

# 노드 식별 이름(컨테이너명 + server-name, 노드마다 고유)
TURN_NODE_NAME=worldlinco-coturn-seoul-01

# 포트(노드별 분리 불필요 시 기본값; 단일 호스트 다중 노드면 노드마다 분리)
TURN_LISTENING_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# 동시 할당 쿼터(노드 용량에 맞게), 0=무제한 BPS
TURN_TOTAL_QUOTA=1200
TURN_BPS_CAPACITY=0
