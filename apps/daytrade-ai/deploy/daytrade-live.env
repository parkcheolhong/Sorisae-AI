# daytrade-ai 라이브 러너 환경 템플릿 → /etc/daytrade/daytrade-live.env 로 복사 후 편집.
# 피드/심볼
FEED=binance
SYMBOL=BTCUSDT
HEARTBEAT=15

# /metrics 노출 포트(Prometheus 스크레이프)
METRICS_PORT=9108

# 영속 경로(systemd ReadWritePaths=/var/lib/daytrade 와 일치해야 함)
DB_PATH=/var/lib/daytrade/live.sqlite
AUDIT_PATH=/var/lib/daytrade/audit.jsonl
REPORT_DIR=/var/lib/daytrade/reports

# 실 브로커(Alpaca REST) 실연동 시 — 미설정이면 paper/모의로 동작
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# 안전: 실거래(LIVE)는 코드의 이중 안전 게이트를 명시적으로 통과해야만 활성화됩니다.
# DAYTRADE_TRADING_MODE=paper
