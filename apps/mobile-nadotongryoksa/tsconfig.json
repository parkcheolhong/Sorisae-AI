{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "lib": [
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "jest",
      "react",
      "react-native"
    ],
    "skipLibCheck": true
  },
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/*.test.js",
    "eas-archive-inspect/**"
  ]
}