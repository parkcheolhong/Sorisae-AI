{
  "name": "mobile-nadotongryoksa",
  "version": "1.0.3",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify:kws:device": "powershell -NoProfile -File ./scripts/verify_on_device_kws.ps1 -LaunchApp",
    "trigger:kws:companion-arm": "powershell -NoProfile -File ./scripts/trigger_kws_companion_arm.ps1",
    "verify:kws:device:trigger": "powershell -NoProfile -File ./scripts/verify_on_device_kws.ps1 -LaunchApp -TriggerCompanionArm",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eas:android:preview": "eas build --platform android --profile preview",
    "eas:android:staging": "eas build --platform android --profile staging",
    "eas:android:production-apk": "eas build --platform android --profile production-apk",
    "eas:android:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^21.14.0",
    "@react-native-firebase/messaging": "^21.14.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~56.0.12",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-contacts": "~56.0.9",
    "expo-dev-client": "~56.0.20",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image-manipulator": "~56.0.20",
    "expo-image-picker": "~56.0.19",
    "expo-intent-launcher": "~56.0.4",
    "expo-local-authentication": "~56.0.4",
    "expo-location": "~56.0.18",
    "expo-notifications": "~56.0.17",
    "expo-secure-store": "~56.0.4",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10",
    "postcss": "^8.5.15",
    "fast-xml-parser": "^5.7.3",
    "send": "^1.2.1",
    "uuid": "^11.1.1"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^expo/virtual/env$": "<rootDir>/src/__tests__/__mocks__/expoVirtualEnv.cjs"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
