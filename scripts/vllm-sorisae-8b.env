# 소리새 friend-chat 전용 vLLM (:8009) — gpu-llm-server/docker-compose.vllm-sorisae-8b.yml
# /v1/models 에 보이는 ID 와 LLM_MODEL_VOICE_CHAT 을 반드시 동일하게 맞출 것.
#
# Qwen3-8B Instruct 계열 AWQ (14B 통역 vLLM 과 GPU 공존, ~6GB 가중치).
VLLM_SORISAE_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_SORISAE_SERVED_NAME=Qwen/Qwen3-8B-AWQ
VLLM_SORISAE_MAX_MODEL_LEN=8192
# :8008 14B AWQ(0.55) + Whisper STT 와 공존 — 여유 VRAM 기준 0.24 전후(약 7.6GB)
VLLM_SORISAE_GPU_MEMORY_UTILIZATION=0.24
VLLM_SORISAE_PORT=8009
HF_CACHE_ROOT=C:/gpu-llm-server-cache/huggingface

# backend (docker-compose / .env)
LLM_VOICE_FRIEND_BASE_URL=http://host.docker.internal:8009/v1
LLM_MODEL_VOICE_CHAT=Qwen/Qwen3-8B-AWQ
